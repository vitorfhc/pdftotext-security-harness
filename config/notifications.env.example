# Use a long random topic. Self-hosted ntfy with authentication is preferred.
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=replace-with-a-long-random-topic

# Optional bearer token for an authenticated ntfy server.
NTFY_TOKEN=

# Set to 0 to send only a generic finding notification.
NTFY_INCLUDE_SUMMARY=1

# Poll interval in seconds.
NTFY_POLL_SECONDS=60
